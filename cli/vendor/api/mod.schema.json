{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://playaconline.com/schemas/mod.schema.json",
  "title": "Play AC Online mod.json",
  "description": "A mod's manifest, mod API levels 1 to 2. Generated from the mod API spec (https://playaconline.com/schemas/api.json). Do not edit by hand. Reference: https://playaconline.com/modding/reference/manifest/",
  "type": "object",
  "required": [
    "schema",
    "api",
    "id",
    "name",
    "version",
    "authors",
    "scope",
    "assets_original"
  ],
  "properties": {
    "$schema": {
      "description": "Optional. The JSON Schema an editor checks mod.json against, for autocomplete and errors as you type. The game ignores it.",
      "type": "string",
      "examples": [
        "https://playaconline.com/schemas/mod.schema.json"
      ]
    },
    "schema": {
      "description": "The manifest format. Always 1.",
      "const": 1,
      "examples": [
        1
      ]
    },
    "api": {
      "description": "The mod API level the mod is made for. The game checks a mod by the rules of its own level, and runs an older level through shims while that level is supported. Use the newest level.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "examples": [
        2
      ]
    },
    "id": {
      "description": "author.mod-name: lowercase letters, digits and dashes, one dot. The author part playaconline, official, admin and example are reserved for the site's own mods in the registry.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,47}$",
      "maxLength": 81,
      "examples": [
        "yourname.tea-house"
      ]
    },
    "name": {
      "description": "The name players see, 1 to 60 characters (after trimming spaces).",
      "type": "string",
      "pattern": "^\\s*\\S(?:[\\s\\S]{0,58}\\S)?\\s*$",
      "examples": [
        "Tea House"
      ]
    },
    "version": {
      "description": "x.y.z, each part 1 to 9 digits with no leading zero. Every upload needs a version number this mod has not used yet (a refused upload's number can be used again).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "examples": [
        "1.0.0"
      ]
    },
    "authors": {
      "description": "1 to 8 names, each 1 to 40 characters.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^\\s*\\S(?:[\\s\\S]{0,38}\\S)?\\s*$"
      },
      "examples": [
        [
          "Your Name"
        ]
      ]
    },
    "description": {
      "description": "Optional text of at most 500 characters. null is refused: leave the key out instead.",
      "type": "string",
      "maxLength": 500,
      "examples": [
        "The flower shop becomes a tea house in the evening."
      ]
    },
    "tags": {
      "description": "Optional. The mod list's filters: at most 5 different tags from a fixed list, lower case. Players filter Player mods by them; the game never reads them. Anything else is refused (manifest-tags).",
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "textures",
          "clothing",
          "furniture",
          "scenery",
          "villagers",
          "dialogue",
          "shops",
          "seasonal",
          "holidays",
          "quality-of-life",
          "translation",
          "humor",
          "accessibility",
          "scripts"
        ]
      },
      "examples": [
        [
          "textures",
          "seasonal"
        ]
      ]
    },
    "scope": {
      "description": "client: only you see it. world: it changes what a visitor to your town would see. Only a world mod may hold a shop (content.shops) or, from api 2, an events file with a board notice. A friend visit needs the same world mods that count (see visit_scope) on both sides.",
      "enum": [
        "client",
        "world"
      ],
      "examples": [
        "client"
      ]
    },
    "content": {
      "description": "What the mod adds, each a path inside the mod. textures, messages and shops; from api 2 also items, letters, events and talk. Anything else is refused. From api 2, messages may name a folder of translations (en.json required; de es fr it).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textures": {
          "type": "string",
          "minLength": 1,
          "description": "A folder with at least one texture file."
        },
        "messages": {
          "type": "string",
          "minLength": 1,
          "description": "The messages file, or from api 2 a folder of <lang>.json (en, de, es, fr, it; en.json required)."
        },
        "shops": {
          "type": "string",
          "minLength": 1,
          "description": "The shops file. Needs scope world."
        },
        "items": {
          "type": "string",
          "minLength": 1,
          "description": "The items file (api 2 and later)."
        },
        "letters": {
          "type": "string",
          "minLength": 1,
          "description": "The letters file (api 2 and later)."
        },
        "events": {
          "type": "string",
          "minLength": 1,
          "description": "The events file (api 2 and later). A board notice needs scope world."
        },
        "talk": {
          "type": "string",
          "minLength": 1,
          "description": "The talk pools file (api 2 and later)."
        }
      },
      "examples": [
        {
          "messages": "messages/en.json"
        }
      ]
    },
    "scripts": {
      "description": "A Lua script and the events it listens to. From api 2 hooks may also list migrate (needs data_version).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main",
        "hooks"
      ],
      "properties": {
        "main": {
          "type": "string",
          "pattern": "\\.lua$",
          "description": "The script file, ending in lowercase .lua."
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/event"
          },
          "description": "Every event the script handles, each once."
        }
      },
      "examples": [
        {
          "main": "main.lua",
          "hooks": [
            "talk",
            "day_start"
          ]
        }
      ]
    },
    "permissions": {
      "description": "The commands the mod's script may queue, each once. The game refuses any command the list leaves out, and the Mods tab and the moderators' review show what the list lets the mod do. Needs scripts. At api 1 the key is unknown and grants nothing.",
      "examples": [
        [
          "send_letter"
        ]
      ]
    },
    "exports": {
      "description": "A library's remote functions, by name, each with a one-line description: what other mods may remote.call. At most 32 names (1 to 32 of a-z 0-9 _), descriptions 1 to 120 characters on one line. Declared, the game lets remote.add offer only these names, and says in the mod log when a listed name was never offered. playac-mod types turns a dependency's exports into editor hints for the mods that depend on it. Needs scripts. At api 1 the key is unknown and does nothing.",
      "examples": [
        {
          "count_pieces": "How many workshop pieces the player bought, as a whole number."
        }
      ]
    },
    "assets_original": {
      "description": "Must be true: your promise that the mod holds only work its authors made, never files taken from the game.",
      "const": true,
      "examples": [
        true
      ]
    },
    "renames": {
      "description": "Old full item id to a full id of an item in this mod's items file, at most 64. Needs content.items. Each rename runs once per save (the sidecar records it), so a renamed item already in a house keeps working.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^([a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,47}):([a-z0-9][a-z0-9-]{0,31})$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,47}):([a-z0-9][a-z0-9-]{0,31})$"
      },
      "examples": [
        {
          "yourname.tea-house:old-cup": "yourname.tea-house:cup"
        }
      ]
    },
    "depends": {
      "description": "Mods this one needs, mod id to version range (\"*\", or up to 4 of >= <= > < = and a version split by one space). At most 16. It loads after them, and not at all when one is missing, off, out of range or not loading. The game checks it again when it starts: a mod whose dependency is not loaded before it, in range, is not loaded at all.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,47}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(\\*|((>=|<=|>|<|=)?(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8}))( ((>=|<=|>|<|=)?(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8}))){0,3})$"
      },
      "examples": [
        {
          "yourname.tea-lib": ">=1.0.0 <2.0.0"
        }
      ]
    },
    "conflicts": {
      "description": "Mods this one cannot run with, mod id to version range. At most 16; an id may not also be in depends. This mod stays off while a matching one is on.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,47}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^(\\*|((>=|<=|>|<|=)?(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8}))( ((>=|<=|>|<|=)?(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8}))){0,3})$"
      },
      "examples": [
        {
          "someone.other-shop": "*"
        }
      ]
    },
    "data_version": {
      "description": "A whole number 1 to 1000000 for the shape of what the scripts save. When it changes, the migrate event runs once per town. The migrate hook needs it.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "examples": [
        1
      ]
    },
    "settings": {
      "description": "At most 16 settings the player sets on the Mods tab and scripts read with settings.get. Types bool, number (whole, min and max), choice (2 to 16 choices) and text (max_length 1 to 200). A world mod's values are part of the visit modset hash.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label",
              "default"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "const": "bool"
              },
              "default": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label",
              "default",
              "min",
              "max"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "const": "number"
              },
              "default": {
                "type": "integer",
                "minimum": -1000000000,
                "maximum": 1000000000
              },
              "min": {
                "type": "integer",
                "minimum": -1000000000,
                "maximum": 1000000000
              },
              "max": {
                "type": "integer",
                "minimum": -1000000000,
                "maximum": 1000000000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label",
              "default",
              "choices"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "const": "choice"
              },
              "default": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label",
              "default",
              "max_length"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "const": "text"
              },
              "default": {
                "type": "string"
              },
              "max_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        ]
      },
      "examples": [
        [
          {
            "name": "greet",
            "type": "bool",
            "label": "Say hello",
            "default": true
          }
        ]
      ]
    }
  },
  "allOf": [
    {
      "description": "depends, conflicts, game, save: Top-level keys reserved for planned features. A key not built at a mod's api level is refused, even when null, so no mod carries one a later game would start obeying. depends and conflicts are built from api 2 (refused only at api 1); game and save are refused at every level.",
      "not": {
        "description": "\"game\", \"save\" are not built yet: take them out",
        "anyOf": [
          {
            "required": [
              "game"
            ]
          },
          {
            "required": [
              "save"
            ]
          }
        ]
      }
    },
    {
      "description": "\"depends\" is built from api 2.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "not": {
          "description": "\"depends\" is not built yet at this api level: take it out, or say \"api\": 2",
          "required": [
            "depends"
          ]
        }
      }
    },
    {
      "description": "\"conflicts\" is built from api 2.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "not": {
          "description": "\"conflicts\" is not built yet at this api level: take it out, or say \"api\": 2",
          "required": [
            "conflicts"
          ]
        }
      }
    },
    {
      "description": "content.shops changes what visitors see, so scope must be \"world\".",
      "if": {
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "required": [
              "shops"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "const": "world"
          }
        }
      }
    },
    {
      "description": "content.items is an api 2 key.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "not": {
          "description": "content.items needs \"api\": 2 or later",
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "required": [
                "items"
              ]
            }
          }
        }
      }
    },
    {
      "description": "content.letters is an api 2 key.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "not": {
          "description": "content.letters needs \"api\": 2 or later",
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "required": [
                "letters"
              ]
            }
          }
        }
      }
    },
    {
      "description": "content.events is an api 2 key.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "not": {
          "description": "content.events needs \"api\": 2 or later",
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "required": [
                "events"
              ]
            }
          }
        }
      }
    },
    {
      "description": "content.talk is an api 2 key.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "not": {
          "description": "content.talk needs \"api\": 2 or later",
          "required": [
            "content"
          ],
          "properties": {
            "content": {
              "required": [
                "talk"
              ]
            }
          }
        }
      }
    },
    {
      "description": "At api 1 scripts.hooks may list only talk, day_start, item_picked, enter_scene.",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "maximum": 1
          }
        }
      },
      "then": {
        "properties": {
          "scripts": {
            "properties": {
              "hooks": {
                "items": {
                  "not": {
                    "description": "this event needs a higher \"api\"",
                    "enum": [
                      "migrate",
                      "hour_change",
                      "shop_buy",
                      "item_sold",
                      "fish_caught",
                      "bug_caught",
                      "letter_read",
                      "villager_moved_in",
                      "visitor_arrived",
                      "command_result",
                      "answer"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "scripts.hooks may list migrate only with a data_version.",
      "if": {
        "required": [
          "scripts"
        ],
        "properties": {
          "scripts": {
            "required": [
              "hooks"
            ],
            "properties": {
              "hooks": {
                "not": {
                  "items": {
                    "not": {
                      "const": "migrate"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "data_version"
        ]
      }
    },
    {
      "description": "permissions requires scripts: only a script can use a command.",
      "if": {
        "required": [
          "api",
          "permissions"
        ],
        "properties": {
          "api": {
            "minimum": 2
          }
        }
      },
      "then": {
        "required": [
          "scripts"
        ]
      }
    },
    {
      "description": "exports requires scripts: only a script offers functions.",
      "if": {
        "required": [
          "api",
          "exports"
        ],
        "properties": {
          "api": {
            "minimum": 2
          }
        }
      },
      "then": {
        "required": [
          "scripts"
        ]
      }
    },
    {
      "description": "permissions is checked from api 2 (an older level ignores it).",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "minimum": 2
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "send_letter",
                "give_item",
                "set_flag",
                "show_line",
                "ask"
              ]
            }
          }
        }
      }
    },
    {
      "description": "exports is checked from api 2 (an older level ignores it).",
      "if": {
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "minimum": 2
          }
        }
      },
      "then": {
        "properties": {
          "exports": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z0-9_]{1,32}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "event": {
      "description": "A script event.",
      "enum": [
        "talk",
        "day_start",
        "item_picked",
        "enter_scene",
        "migrate",
        "hour_change",
        "shop_buy",
        "item_sold",
        "fish_caught",
        "bug_caught",
        "letter_read",
        "villager_moved_in",
        "visitor_arrived",
        "command_result",
        "answer"
      ]
    }
  }
}
